PORT=3000
NODE_ENV=production
# In non-production, direct reset links open in a new tab by default.
# Set true to enable this intentionally; set false to always use email.
PASSWORD_RESET_DIRECT_LINK=false

# Use either DATABASE_URL or the DB_* values below.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL=true

DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cya_db

SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com

# Set this to your deployed site URL, for example:
# https://your-app.onrender.com
APP_ORIGIN=
CORS_ALLOWED_ORIGINS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recommended cloud media storage (Cloudflare R2: 10 GB free with zero egress fees).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PREFIX=cya-platform

# Optional legacy fallback if using Cloudinary instead of Cloudflare R2.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cya-platform/gallery
